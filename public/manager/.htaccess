# ===================================================================
# ЗАЩИТНЫЙ ЗАМОК ИНЖЕНЕРНОГО ШЛЮЗА (MyNewAttemp Engine)
# ===================================================================

# 1. Включаем базовую авторизацию Apache
AuthType Basic
AuthName "MyNewAttemp Engine - Личный кабинет сотрудника"

# Жесткий абсолютный путь к хэшам паролей в новой системной папке
AuthUserFile "C:/xampp/htdocs/MyNewAttemp/app/data/system/.htpasswd"
Require valid-user

# 2. Дополнительные протоколы безопасности папки
# Намертво запрещаем просмотр структуры каталога в браузере (выдаст 403 Forbidden)
Options -Indexes

# Запрещаем переопределение критических директив через дочерние скрипты
AllowOverride None

# Кодировка по умолчанию для этой зоны, чтобы логи и таблицы не ломали шрифты
AddDefaultCharset UTF-8
